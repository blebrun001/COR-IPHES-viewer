{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COR-IPHES Esqueletos Off-linea",
  "version": "0.1.0-alpha.1",
  "identifier": "cat.iphes.cor.esqueletos.offlinea",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "COR-IPHES Esqueletos Off-linea",
        "label": "main",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["$APPLOCALDATA/**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education"
  }
}
